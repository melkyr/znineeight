// repro/single_ptr_slice_ok.z98 — standalone FH (Volume II D10) positive.
//
// Compile + run (seed-built zig1 with its sibling lib/):
//   mkdir -p /tmp/single_ptr_slice_ok
//   <zig1> -o /tmp/single_ptr_slice_ok repro/single_ptr_slice_ok.z98
//   cd /tmp/single_ptr_slice_ok && sh build_target.sh linux single_ptr_slice_ok
//   ./single_ptr_slice_ok
//
// EXPECTED (after the fix): stdout
//   lens=0 1 0 v=42 sl0=42 c=42 vv=7 pa1=20 pas1=20 dv=42 mp=20
// rc=0, matching Zig 0.15.2 (the three legal `*T` slices type as
// `*[0]T`/`*[1]T` and carry const/volatile; `*[N]T` and the deref/many-pointer
// controls are unchanged).
// DEFECT (before the fix): `p[0..1]` yielded `[]T` and `v01` dropped volatile.
const std = @import("std");

pub fn main() void {
    var x: i32 = 42;
    const p: *i32 = &x;
    const t00: *[0]i32 = p[0..0];
    const t01: *[1]i32 = p[0..1];
    const t11: *[0]i32 = p[1..1];
    const v = t01[0];
    const sl: []i32 = t01;
    const cp: *const i32 = &x;
    const ct01: *const [1]i32 = cp[0..1];
    var xv: i32 = 7;
    const vp: *volatile i32 = &xv;
    const vt: *volatile [1]i32 = vp[0..1];
    const vv = vt[0];

    var arr = [3]i32{ 10, 20, 30 };
    const pa: *[3]i32 = &arr;
    const pa1 = pa[1];
    const pas = pa[0..2];
    const psl: []i32 = pas;

    const dv = p.*;
    var marr = [3]i32{ 10, 20, 30 };
    const mp: [*]i32 = marr;
    const mpv = mp[1];

    std.io.print("lens={} {} {} v={} sl0={} c={} vv={} pa1={} pas1={} dv={} mp={}\n", .{ t00.len, t01.len, t11.len, v, sl[0], ct01[0], vv, pa1, psl[1], dv, mpv });
}
