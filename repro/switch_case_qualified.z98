// repro/switch_case_qualified.z98 — standalone FX4 (Volume II D11 extras)
// positive control: valid qualified, alias-qualified and shorthand switch
// prongs must keep compiling and dispatching exactly as before the FX4
// validation gate (no false `error[3071]`).
//
// Expected stdout (exact), rc 0:
//   q=12
//   r=6
//   e=1
//   e2=2
//   done
const std = @import("std");

const Shape = union(enum) {
    circle: i32,
    rect: i32,
    empty,
};

const ShapeAlias = Shape;
const Color = enum { red, green };

fn shapeVal(s: Shape) i32 {
    return switch (s) {
        ShapeAlias.circle => |r| r,
        .rect => |r| r,
        else => 0,
    };
}

fn colorVal(c: Color) i32 {
    return switch (c) {
        Color.red => 1,
        .green => 2,
        else => 0,
    };
}

pub fn main() void {
    var a: Shape = Shape{ .circle = 12 };
    var b: Shape = Shape{ .rect = 6 };
    std.io.print("q={}\n", .{shapeVal(a)});
    std.io.print("r={}\n", .{shapeVal(b)});
    std.io.print("e={}\n", .{colorVal(Color.red)});
    std.io.print("e2={}\n", .{colorVal(.green)});
    std.io.print("done\n", .{});
}
