// repro/sig_known_type_ok.z98 — standalone FX13-F (Volume II ch12) positive
// control.
//
// Every valid signature type form must stay accepted and runtime-correct
// after FX13-F: forward alias, forward struct, self-referential struct, alias
// chain, `error{...}` set, `E!T` error union, `u4`/`u7`, `c_char`/`bool`,
// named fn-pointer parameter, implicit-void return, and the operator-ruled
// `noreturn` exemption (degraded to void, never diagnosed). The `anytype`
// signature shape is now rejected (see `repro/mi_matrix/anytype_reject_xmod`).
//
// Contract: rc 0, RUNRC 0, deterministic stdout below, 3x byte-exact.
const std = @import("std");

fn fwdAlias(x: Later) Later {
    return x;
}
const Later = i32;

fn fwdStruct(n: *Node) i32 {
    return n.v;
}
const Node = struct { v: i32, next: ?*Node };

const A = B;
const B = C;
const C = i32;
fn chain(x: A) A {
    return x;
}

fn eset(e: error{Foo, Bar}) void {
    if (e == error.Foo) {
        std.io.print("foo\n");
    }
}

const E = error{Foo};
fn errunion() E!i32 {
    return 7;
}

fn width4(x: u4) u4 {
    return x;
}
fn width7(x: u7) u7 {
    return x;
}

fn scalars(c: c_char, b: bool) void {
    _ = c;
    _ = b;
}

fn implicit() void {}

fn apply(cb: fn (i32) i32, x: i32) i32 {
    return cb(x);
}
fn inc(v: i32) i32 {
    return v + 1;
}

fn stop() noreturn {
    while (true) {}
}

pub fn main() void {
    var n = Node{ .v = 5, .next = null };
    std.io.printInt(fwdAlias(1));
    std.io.print("\n");
    std.io.printInt(fwdStruct(&n));
    std.io.print("\n");
    std.io.printInt(chain(2));
    std.io.print("\n");
    eset(error.Foo);
    const eu = errunion() catch 0;
    std.io.printInt(eu);
    std.io.print("\n");
    std.io.printInt(@intCast(i32, width4(3)));
    std.io.print("\n");
    std.io.printInt(@intCast(i32, width7(4)));
    std.io.print("\n");
    scalars('x', true);
    implicit();
    std.io.printInt(apply(inc, 6));
    std.io.print("\n");
}
