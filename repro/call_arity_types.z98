// call_arity_types.z98 — standalone reproduction for the Task 14 (S2) fix.
//
// Compile (seed-built zig1 with its sibling lib/):
//   <zig1> --dump-c89 --output-dir /tmp/call_arity_types repro/call_arity_types.z98
//
// EXPECTED (after the fix): dump rc=2, 0 `.c`,
//   error[3061]: expected 2 argument(s), found 1          (`add(2)`)
//   error[3061]: expected 2 argument(s), found 3          (`add(1, 2, 3)`)
//   error[3000]: type mismatch in function argument ...   (`add(1, true)`,
//                                                          source: bool /
//                                                          target: i32)
//
// DEFECT (before the fix): a wrong-arity call compiled rc=0 and failed only at
// gcc (`too few`/`too many arguments to function`), and a wrong argument type
// built, linked and ran — `add(1, true)` prints `2` via a silent
// `bool` -> `i32` coercion. Official Zig 0.15.2 rejects all three
// (`expected 2 argument(s), found 1` / `... found 3`;
// `expected type 'i32', found 'bool'`).
//
// FIX (Task 14): `semanticAnalyzerResolveFnCall` enforces the callee's arity
// (new level-0 `error[3061]` ERR_3061_WRONG_ARGUMENT_COUNT, Zig's
// "expected N argument(s), found M" wording) and per-argument assignability
// (`error[3000]`, the existing "type mismatch in function argument"
// diagnostic) at the call site, on both the direct-call and the fn-value
// paths. Valid forms (exact arity, correct types, `@intCast` conversions) are
// unchanged — see repro/mi_matrix/stdlib_call_arity_types_ok_xmod.
fn add(a: i32, b: i32) i32 {
    return a + b;
}

pub fn main() void {
    var s: i32 = add(2);
    _ = s;
    var t: i32 = add(1, 2, 3);
    _ = t;
    var u: i32 = add(1, true);
    _ = u;
}
