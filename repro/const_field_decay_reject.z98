// repro/const_field_decay_reject.z98 — standalone FX11 (Volume II) reject census.
//
// The aggregate-field-bound const-array holes closed by FX11: a const
// aggregate's array field must not decay/alias into a mutable slice,
// many-pointer, pointer or element site. Same materialisation-site sweep as
// `repro/mi_matrix/const_field_decay_reject_xmod`, in one file:
// module vars, returns, local declarations, assignments, `*const S` field
// access, field initializers, call arguments and array-literal element sites.
//
// EXPECTED: dump rc 2, 0 `.c`, exactly 23 level-0
// `error[3000]: cannot implicitly discard 'const' qualifier`, 0 warnings,
// 0 other codes. The legal const-ADDING rows at the bottom add no diagnostic.
// Zig 0.15.2 rejects every row (the standalone twin is the oracle check).
const std = @import("std");

const S = struct { a: [3]i32 };
const garr = [3]i32{ 1, 2, 3 };
const gs: S = .{ .a = garr };
const cp: *const S = &gs;

const H = struct { m: []i32 };

fn takeSlice(s: []i32) void {
    s[0] = 9;
}

fn takeMany(p: [*]i32) void {
    p[0] = 9;
}

fn takeElemPtr(p: *i32) void {
    p.* = 9;
}

var msink: []i32 = gs.a[0..];
var mmink: [*]i32 = gs.a[0..];

fn leakSlice() []i32 {
    return gs.a[0..];
}

fn leakMany() [*]i32 {
    return gs.a[0..];
}

fn leakElemPtr() *i32 {
    return gs.a;
}

fn leakArrPtr() *[3]i32 {
    return &gs.a;
}

pub fn main() void {
    var s: []i32 = gs.a[0..];
    var m: [*]i32 = gs.a[0..];
    var p: *[3]i32 = &gs.a;
    var sa: []i32 = &gs.a;
    var ma: [*]i32 = &gs.a;
    var q: *i32 = gs.a;

    s = gs.a[0..];
    m = &gs.a;
    q = cp.a;

    var ps: []i32 = cp.a[0..];
    var pa: *[3]i32 = &cp.a;

    const hh: H = .{ .m = gs.a[0..] };

    takeSlice(gs.a[0..]);
    takeMany(&gs.a);
    takeElemPtr(gs.a);

    const e1 = [1][]i32{ gs.a };
    const e2 = [1][]i32{ gs.a[0..] };

    // Green guard: legal const-ADDING rows emit nothing.
    const okS: []const i32 = gs.a[0..];
    const okM: [*]const i32 = gs.a[0..];
    const okP: *const [3]i32 = &gs.a;
    const okA: []const i32 = &gs.a;
    const okQ: *const i32 = gs.a;
    const okE = [1][]const i32{ gs.a[0..] };
    if (okS[0] + okM[1] + okP[2] + okA[0] + okQ.* + okE[0][1] != 9) {
        @panic("green guard failed");
    }

    _ = leakSlice;
    _ = leakMany;
    _ = leakElemPtr;
    _ = leakArrPtr;
    _ = e1;
    _ = e2;
    _ = hh;
    _ = s;
    _ = m;
    _ = p;
    _ = sa;
    _ = ma;
    _ = q;
    _ = ps;
    _ = pa;
    _ = msink;
    _ = mmink;
    std.io.print("unreached\n", .{});
}
