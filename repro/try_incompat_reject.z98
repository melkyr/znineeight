//
// Contract now: dump rc 2, 0 `.c`, exactly 1 level-0 `error[3075]`
// (`try error set may not be compatible with the enclosing function's return
// type`; set-only comparison, no `anyerror`), no signals.
const E1 = error{A};
const E2 = error{B};

fn g() E2!void {
    return error.B;
}

fn f() E1!void {
    try g();
}

pub fn main() void {
    f() catch { };
}
