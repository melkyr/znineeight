// errdefer_dynamic_return.z98 — standalone reproduction for the Task 10F fix.
//
// Compile + run (seed-built zig1 with its sibling lib/):
//   <zig1> -o /tmp/errdefer_dyn_repro repro/errdefer_dynamic_return.z98
//   (cd /tmp/errdefer_dyn_repro && sh build_target.sh linux /tmp/errdefer_dyn_repro/prog)
//   /tmp/errdefer_dyn_repro/prog
//
// DEFECT (before the fix): `sf/src/lower.zig` return_stmt lowering classified a
// return as an error exit only when the expression carried a recorded
// `wrap_error_err` coercion or was an `error_literal`. For a dynamic error-union
// return (`return x;` with `x: E!T`, or `return g();` with `g() E!T`) the source
// and destination error-union types are identical, so no coercion is recorded
// (`tryRecordCoercion` early-returns on src==dst), `ret_is_error` stayed 0,
// `expandDefers` skipped the errdefer bodies, and no runtime `is_error` branch
// was emitted — the error value was returned with its errdefer silently
// dropped.
//
// FIX (Task 10F): when (a) no static classification, (b) the return
// expression's resolved type is an error union, (c) the function return type is
// an error union, and (d) a pending `errdefer` exists, `return_stmt` lowering
// lowers the value, emits `check_error` + `branch` (mirroring the `try` path),
// and runs `expandDefers(0,1,0)` on the error arm / `expandDefers(0,0,0)` on the
// success arm before `ret val`. The pending-errdefer gate keeps every other
// error-union return byte-identical.
//
// EXPECTED stdout after the fix (each `undo` is the errdefer of a dynamic
// error-union return in its error state; `42`/`7` are the success values, which
// must NOT be preceded by `undo`):
//
//   undo
//   varErr-caught
//   42
//   undo
//   callErr-caught
//   7
//   undo
//   subErr-caught
//   undo
//   ctrlErr-caught
//   undo
//   tryDyn-caught
//   done
const std = @import("std");
const E = error{Boom};
const F = error{Boom};

fn p(v: i32) void {
    std.io.printInt(v);
    std.io.writeByte('\n');
}

fn g() E!i32 { return error.Boom; }
fn gok() E!i32 { return 7; }

// dynamic EU variable, error value — must run errdefer.
fn varErr() E!i32 {
    var x: E!i32 = error.Boom;
    errdefer std.io.print("undo\n");
    return x;
}

// dynamic EU variable, success value — must NOT run errdefer.
fn varOk() E!i32 {
    var x: E!i32 = 42;
    errdefer std.io.print("undo\n");
    return x;
}

// dynamic EU call return, error value — must run errdefer.
fn callErr() E!i32 {
    errdefer std.io.print("undo\n");
    return g();
}

// dynamic EU call return, success value — must NOT run errdefer.
fn callOk() E!i32 {
    errdefer std.io.print("undo\n");
    return gok();
}

// subset EU return (`F!i32` -> `E!i32`), error value — must run errdefer.
fn subErr() E!i32 {
    var x: F!i32 = error.Boom;
    errdefer std.io.print("undo\n");
    return x;
}

// static error literal (Task 10B control) — must run errdefer.
fn ctrlErr() E!i32 {
    errdefer std.io.print("undo\n");
    return error.Boom;
}

// `try` propagation (existing control) — must run errdefer.
fn tryDyn() E!i32 {
    var x: E!i32 = error.Boom;
    errdefer std.io.print("undo\n");
    return try x;
}

pub fn main() !void {
    varErr() catch { std.io.print("varErr-caught\n"); };
    var vok: i32 = varOk() catch { std.io.print("varOk-caught\n"); return; };
    p(vok);
    callErr() catch { std.io.print("callErr-caught\n"); };
    var cok: i32 = callOk() catch { std.io.print("callOk-caught\n"); return; };
    p(cok);
    subErr() catch { std.io.print("subErr-caught\n"); };
    ctrlErr() catch { std.io.print("ctrlErr-caught\n"); };
    tryDyn() catch { std.io.print("tryDyn-caught\n"); };
    std.io.print("done\n");
}
