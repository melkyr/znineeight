// comptime_coerce_reject.z98 — standalone reproduction for Task 4
// (out-of-range coercion of a comptime integer into a typed slot).
//
// Recipe (seed-built zig1 with its sibling lib/):
//   <zig1> --dump-c89 --output-dir /tmp/coerce_rej repro/comptime_coerce_reject.z98
//   echo "dump rc=$?"   # expect 2, 0 emitted .c
//
// BEFORE Task 4 (and, for the fix-round sites, before its first fix round)
// these shapes compiled and ran WRONG values or emitted invalid C:
//   `const U8FOLD: u8 = 250 + 60;`          emitted `(unsigned char)(310)` = 54;
//   `const BIGFOLD = 1 << 100;`             never folded, ran a wrapped value;
//   `const NEGU: u64 = @as(i64, -1);`       emitted 18446744073709551615;
//   `const NEGI8: i8 = @as(i32, -200);`     truncated silently;
//   `var y: u32 = 0 - 1;`                   ran 4294967295 with NO diagnostic (Important 1);
//   `take8(300);` / `return 300;`           ran 44 with NO diagnostic (Important 2);
//   `takeOpt8(@as(i32, 300));`
//   `var o: ?u8 = @as(i32, 300);`           emitted gcc-invalid C (Important 4).
// Official Zig 0.15.2 rejects every site except `BIGFOLD` (unused
// comptime_int) — that one is the documented bounded divergence (Task 1 §8
// risk 1): Z98 has no runtime slot that can hold it, so it refuses to emit
// wrong C.
//
// AFTER Task 4: dump rc=2, 0 `.c`,
//   error[3000]: comptime integer value does not fit the target type
// (the `@intCast` fold class keeps its own message; the full matrix lives in
// `repro/mi_matrix/comptime_coerce_reject_xmod`).
const U8FOLD: u8 = 250 + 60;
const BIGFOLD = 1 << 100;
const NEGU: u64 = @as(i64, -1);
const NEGI8: i8 = @as(i32, -200);

fn take8(x: u8) void {
    _ = x;
}

fn takeOpt8(x: ?u8) void {
    _ = x;
}

fn retLit() u8 {
    return 300;
}

fn varBad() void {
    var y: u32 = 0 - 1;
    _ = y;
}

fn localOpt() void {
    var o: ?u8 = @as(i32, 300);
    _ = o;
}

pub fn main() void {
    take8(300);
    takeOpt8(@as(i32, 300));
    _ = retLit();
    varBad();
    localOpt();
    _ = U8FOLD;
    _ = BIGFOLD;
    _ = NEGU;
    _ = NEGI8;
}
