// ptr_array_slice_reject.z98 — FX5 standalone reject repro.
//
// A many-item-pointer open-ended slice (`mp[s..]`) has no length: Zig 0.15.2
// accepts it as `[*]T`, but Z98's slice result is `[]T`, so FX5 clean-rejects
// `error[3067]` (`slice of many-item pointer must be bounded`) at level 0,
// rc 2 / 0 `.c` — the former `error[3043]` ICE is gone.
const std = @import("std");

pub fn main() void {
    var arr = [4]i32{ 10, 20, 30, 40 };
    const mp: [*]i32 = &arr;
    var a: usize = 1;
    const s0 = mp[0..];
    const s1 = mp[1..];
    const s2 = mp[a..];
    _ = s0;
    _ = s1;
    _ = s2;
}
