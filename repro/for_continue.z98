// for_continue.z98 — Task 10B standalone repro (defect A): `continue` in a
// `for` loop must run the loop's implicit step before the next condition test
// (spec §3.2). Pre-fix (seed v80) `continue` jumped straight to the condition,
// so the range/index never advanced and the loop hung (emit/build rc 0, no
// diagnostic, runtime timeout). Post-fix this matches official Zig 0.15.2.
//
// Expected stdout:
//   n=0 n=1 n=3 n=4 done
//   x=10 x=20 x=40 done
//   i=0 x=10
//   i=2 x=30
//   i=3 x=40
//   never=3 side=5 count=4
// rc 0.
const std = @import("std");

pub fn main() void {
    for (0..5) |n| {
        if (n == 2) continue;
        std.io.print("n={} ", .{n});
    }
    std.io.print("done\n", .{});

    var a: [4]i32 = [4]i32{ 10, 20, 30, 40 };
    for (a) |x| {
        if (x == 30) continue;
        std.io.print("x={} ", .{x});
    }
    std.io.print("done\n", .{});

    for (a) |x, i| {
        if (i == 1) continue;
        std.io.print("i={} x={}\n", .{ i, x });
    }

    var never: u32 = 0;
    for (0..3) |n| {
        _ = n;
        never += 1;
        continue;
    }
    var side: u32 = 0;
    var count: u32 = 0;
    for (0..5) |n| {
        side += 1;
        if (n == 2) continue;
        count += 1;
    }
    std.io.print("never={} side={} count={}\n", .{ never, side, count });
}
